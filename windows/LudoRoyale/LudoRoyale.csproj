<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ludo Royale for Windows: a small host for the game's web client.
    .NET Framework 4.8 (part of Windows 10 1903+ and Windows 11) + the WebView2 runtime (part of Windows 11
    and current Windows 10), so the download stays at a couple of megabytes.
    AnyCPU: runs natively on x64, x86 and ARM64 (the WebView2 loader for each is in runtimes\).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LudoRoyale</AssemblyName>
    <RootNamespace>LudoRoyale</RootNamespace>
    <ApplicationIcon>Assets\LudoRoyale.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>LudoRoyale.Program</StartupObject>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Version>1.0.0</Version>
    <Product>Ludo Royale</Product>
    <AssemblyTitle>Ludo Royale</AssemblyTitle>
    <Description>Ludo Royale</Description>
    <Company>Muhammad Noman</Company>
    <Copyright>Copyright © 2026 Muhammad Noman</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <!-- The game server this build talks to (build.ps1 -Server https://...); LUDO_SERVER_URL overrides it at run time. -->
  <PropertyGroup>
    <LudoServer Condition="'$(LudoServer)' == ''">https://ludo.nomanshafiq.com</LudoServer>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="DefaultServer" Value="$(LudoServer)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\LudoRoyale.ico" />
  </ItemGroup>

  <!-- The web client (npm run build -> web\dist) is served to WebView2 from a "web" folder next to the exe. -->
  <ItemGroup Condition="Exists('..\..\web\dist\index.html')">
    <None Include="..\..\web\dist\**\*" Exclude="..\..\web\dist\_headers" LinkBase="web" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\THIRD-PARTY-NOTICES.txt')" />
  </ItemGroup>

</Project>
